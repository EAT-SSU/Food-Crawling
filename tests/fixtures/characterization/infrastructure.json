  "function_contract": {
    "count": 9,
    "runtime": "python3.11",
    "architecture": "arm64",
    "timeout": 300,
    "memory": 512,
    "public_api_event_count": 0,
    "function_url_count": 0,
    "manual_invocation": "lambda:InvokeFunction",
