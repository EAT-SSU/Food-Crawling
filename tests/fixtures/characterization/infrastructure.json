  "function_contract": {
    "count": 9,
    "runtime": "python3.11",
    "architecture": "arm64",
    "timeout": 300,
    "memory": 512,
    "public_api_event_count": 0,
    "function_url_count": 0,
    "manual_invocation": "lambda:InvokeFunction",
    "function_policy_count": 0
  },
  "general_schedule": {
    "logical_resources": ["DodamSchedulingFunction", "HaksikSchedulingFunction", "FacultySchedulingFunction"],
    "expression": "cron(0 7 ? * SUN *)",
    "input": {"trigger": "eventbridge", "delayed_schedule": false},
    "event_type": "Schedule"
  },
  "dormitory_schedule": {"expression": "cron(0 23 ? * SUN *)"},
  "state_machine": {
    "logical_resource": "DormitoryRetryStateMachine",
    "definition": "statemachine/dormitory-retry-workflow.asl.json",
    "substitutions": {
      "DormitorySchedulingFunctionArn": "DormitorySchedulingFunction.Arn",
      "NotifyFailureFunctionArn": "NotifyFailureFunction.Arn"
    },
    "policies": ["DormitorySchedulingFunction", "NotifyFailureFunction"],
    "invoke_payload": {"trigger": "step_functions", "execution_id.$": "$$.Execution.Id", "retry_count.$": "$$.State.RetryCount", "delayed_schedule": false},
    "failure_payload": {"trigger": "step_functions", "execution_id.$": "$$.Execution.Id", "restaurant": "DORMITORY", "error_type.$": "$.error.Error"},
    "local_retry": {"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0},
    "domain_retry": {"ErrorEquals": ["RetryableEmptyMenuError", "RetryableApiSendError"], "IntervalSeconds": 7200, "MaxAttempts": 5, "BackoffRate": 1.0}
  }
